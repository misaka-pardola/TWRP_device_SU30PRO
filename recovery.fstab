/uboot               emmc     /dev/block/nvme0n1p2                            flags=display=uboot/mnt/internal_sd     vfat     
/dev/block/platform/ff0f0000.dwmmc/by-name/user  ext4   flags=display=internal_sd
/trust               emmc     /dev/block/nvme0n1p3                            flags=display=trust
/super               ext4     /dev/block/by-name/super                             flags=display=super
/mnt/external_sd     vfat     /dev/block/mmcblk0p1                                flags=display=external_sd
/system              ext4     /dev/block/mapper/system                           flags=display=system
/vendor              ext4     /dev/block/mapper/vendor                           flags=display=vendor
/product             ext4     /dev/block/mapper/product                          flags=display=product
/system_ext          ext4     /dev/block/mapper/system_ext                       flags=display=system_ext
/vendor_dlkm         ext4     /dev/block/mapper/vendor_dlkm                      flags=display=vendor_dlkm
/cache               ext4     /dev/block/nvme0n1p10                            flags=display=cache
/metadata            ext4     /dev/block/nvme0n1p11                         flags=display=metadata
/data                f2fs     /dev/block/by-name/userdata                        flags=display=data
/boot                emmc     /dev/block/by-name/boot                             flags=display=boot
/recovery            emmc     /dev/by-name/nvme0n1p8                         flags=display=recovery
/vbmeta              emmc     /dev/block/nvme0n1p6                           flags=display=vbmeta
/dtbo                emmc     /dev/block/nvme0n1p5                            flags=display=dtbo

